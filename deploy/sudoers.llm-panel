# /etc/sudoers.d/llm-panel — ПРЕДЛОЖЕНИЕ (этап 1). НЕ УСТАНАВЛИВАТЬ без отдельного
# подтверждения (ТЗ §12.5): это изменение прав. Установка — через visudo -f.

# Право ровно одно: запуск root-owned helper с фиксированным путём.
# НЕ выдавать общий sudo systemctl *, НЕ выдавать shell от root (ТЗ §6.3).
dispot ALL=(root) NOPASSWD: /usr/local/sbin/llm-panel-systemd

# Замечания по риску:
#   * dispot сможет безопасно (по allowlist внутри helper) управлять разрешёнными
#     юнитами и читать их журналы. Любая попытка передать чужой юнит/неизвестную
#     операцию отвергается самим helper (второй рубеж после FastAPI).
#   * Права затираются в env_reset (по умолчанию sudo) — helper не полагается
#     на передаваемое окружение; allowlist путь фиксирован внутри скрипта.
# Откат:
#   sudo rm /etc/sudoers.d/llm-panel && sudo visudo -c
