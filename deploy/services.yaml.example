# Описания сервисов для панели (ТЗ §4.1) — УНИВЕРСАЛЬНЫЙ ШАБЛОН.
# Файл на сервере: /etc/llm-panel/services.yaml (читается панелью, правит администратор ОС).
#
# ЗАПОЛНЕНИЕ ПОД СВОЙ СЕРВЕР:
#   1. Выполните read-only обследование: bash scripts/survey.sh > survey.out 2>&1
#      (и scripts/survey2.sh для уточнений) — скрипт ничего не меняет, только читает.
#   2. Впишите ФАКТИЧЕСКИЕ имена юнитов, порты, health-URL и GPU-UUID.
#   3. GPU-UUID: nvidia-smi -L  (полные UUID вида GPU-xxxxxxxx-...; НЕ индексы —
#      индексы меняются между загрузками, ТЗ §2).
#   4. Имена существующих юнитов НЕ нормализуются по регистру — пишите точно как
#      в systemctl (например llama-Qwen3.8_GGUF.service).
#   5. Юниты, отсутствующие в этом файле, панель не показывает вовсе.
#
# Пример ниже — ВЫМЫШЛЕННЫЙ (заглушки). Замените всё или удалите лишнее.
# Реальный пример заполнения — deploy/examples/services.yaml.station-llm.yaml.
#
# Конвенция адресации CUDA задаётся вами (поле cuda_addressing на сервисе):
#   uuid  — сервис адресует карты по полным UUID (надёжно против перестановок карт);
#   index — сервис адресует по индексам (например CUDA_VISIBLE_DEVICES=0,1 в
#           старт-скрипте); панель выводит индексы заново на момент запуска из
#           NVML, проверка missing_gpu всегда выполняется по UUID.

services:
  # --- пример GPU-сервиса типа vllm ----------------------------------------
  - id: vllm-example
    name: "vLLM — пример описания"
    type: vllm
    unit: vllm-example.service            # фактическое имя юнита: systemctl list-units
    managed: adopted                      # adopted = юнит существует вне панели
    edit_mode: manage_only                # панель управляет, но не редактирует юнит
    port: 8000
    bind_host: 127.0.0.1                  # фактический адрес слушания сервиса
    health:
      kind: http
      url: http://127.0.0.1:8000/health   # только 127.0.0.1 (ТЗ §4.1)
      timeout_s: 3
      interval_s: 10
    startup_timeout: 600                  # сек; большие модели — больше (до 3600)
    gpus:                                 # ПОЛНЫЕ UUID из nvidia-smi -L
      - GPU-00000000-0000-0000-0000-000000000000   # замените на реальные
    cuda_addressing: index                # или uuid — как фактически адресует сервис
    notes: >-
      Свободное поле для заметок: ExecStart, env, конфликты systemd и т.п.
      Отображается в настройках сервиса в панели.

  # --- пример GPU-сервиса типа llamacpp ------------------------------------
  - id: llamacpp-example
    name: "llama.cpp — пример описания"
    type: llamacpp
    unit: llamacpp-example.service
    managed: adopted
    edit_mode: manage_only
    port: 8002
    bind_host: 127.0.0.1
    health:
      kind: http
      url: http://127.0.0.1:8002/health
      timeout_s: 3
      interval_s: 10
    gpus:
      - GPU-00000000-0000-0000-0000-000000000000
    cuda_addressing: uuid
    notes: >-
      Если сервис слушает порт, общий с другим юнитом, юниты взаимоисключающие
      по порту — предупреждение даст панель (этап 2).

  # --- пример CPU/вспомогательного сервиса ---------------------------------
  - id: generic-example
    name: "Вспомогательный сервис (пример)"
    type: generic
    unit: generic-example.service
    managed: adopted
    edit_mode: manage_only
    port: 8080
    bind_host: 127.0.0.1
    health:
      kind: tcp                           # tcp-проверка, если HTTP-эндпоинта нет
      port: 8080
      timeout_s: 3
      interval_s: 15
    gpus: []                              # пусто = сервис без GPU (CVD не задаётся)
    notes: >-
      Юниты, которые панель не должна даже останавливать (например oneshot
      системной настройки), ограничьте в allowlist.json действиями
      status+journal.

  # --- пример systemd USER-юнита --------------------------------------------
  # Юниты ~/.config/systemd/user/*.service (менеджер systemctl --user) НЕ видны
  # системному менеджеру: systemctl list-units/show без --user их не отдаёт,
  # поэтому они не попадают ни в обследование, ни в «Поиск сервисов» системных
  # юнитов. Чтобы показать такой сервис, добавьте запись с scope: user.
  # Панель работает от того же пользователя, что владеет юнитом, и выполняет
  # чтение/действия/журнал напрямую systemctl --user / journalctl --user —
  # helper и allowlist.json для user-юнитов НЕ нужны.
  - id: openclaw-example
    name: "OpenClaw Gateway (пример user-юнита)"
    type: generic
    unit: openclaw-gateway.service
    scope: user                           # system (по умолчанию) | user
    managed: adopted
    edit_mode: manage_only
    port: 18789
    bind_host: 127.0.0.1
    health:
      kind: tcp
      port: 18789
      timeout_s: 3
      interval_s: 15
    gpus: []
    notes: >-
      Идентификатор user-юнита, найденного «Поиском сервисов» и отмеченного
      в Config Panel, — ПОЛНОЕ имя юнита (с суффиксом .service) и префиксом
      user: — защита от коллизии с одноимённым системным юнитом.
