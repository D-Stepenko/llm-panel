# /etc/systemd/system/llm-panel.service — ШАБЛОН.
# Запуск от непривилегированного пользователя (не root). Окружение — .venv в
# домашнем каталоге (не системный Python — ТЗ §7). Слушает только 127.0.0.1;
# наружу отдаёт Caddy (отдельный сайт-блок, см. docs/DEPLOY.md §5).
#
# Плейсхолдеры подставляются deploy/install.sh:
#   @@PANEL_USER@@  — пользователь панели
#   @@PANEL_GROUP@@ — её группа
#   @@PANEL_DIR@@   — каталог установки (код + .venv)
#   @@CONFIG_FILE@@ — путь к config.yaml
#
# ВАЖНО про sandbox (урок станции 2026-10-28):
#   * NoNewPrivileges=yes ЗАПРЕЩЁН: панель вызывает sudo -n <helper>, а этот
#     флаг делает sudo невозможным (код возврата 1, «Сервисами невозможно
#     управлять»). Управление сервисами в архитектуре ТЗ §6.3 идёт через sudo.
#   * CapabilityBoundingSet (в том числе в drop-in) ЗАПРЕЩЁН: sudo после
#     setuid-root получает permitted = bounding set, и без CAP_SETGID падает
#     («unable to change to root gid: Operation not permitted»). Для чтения
#     RAPL использовать ТОЛЬКО AmbientCapabilities — см. docs/DEPLOY.md §6.1.
#   * ProtectSystem=strict требует явного ReadWritePaths= на каталог данных,
#     иначе запись БД/аудита будет нарушена. Включайте sandbox-опции ПО ОДНОЙ
#     с проверкой (nvml, запись БД, sudo -n … status <юнит> от имени пользователя).
#   * Всё, куда панель должна писать (каталог данных, каталоги моделей для
#     HF-загрузок, …), перечислите в ReadWritePaths= — иначе ProtectSystem=strict
#     / ProtectHome=read-only дадут дочернему `hf download` Errno 30 (EROFS),
#     и панель покажет уведомление с этой инструкцией.
#   * XDG_RUNTIME_DIR: user-юниты (scope: user, напр. openclaw-gateway.service)
#     панель вызывает напрямую systemctl --user / journalctl --user. Из
#     системного сервиса переменной нет → «Failed to connect to bus: No medium
#     found». Панель задаёт XDG_RUNTIME_DIR=/run/user/<uid> сама (systemd_units);
#     дополнительно ничего в юните прописывать не нужно.

[Unit]
Description=LLM Panel — локальная веб-панель управления LLM-станцией
After=network-online.target
Wants=network-online.target

[Service]
User=@@PANEL_USER@@
Group=@@PANEL_GROUP@@
WorkingDirectory=@@PANEL_DIR@@
Environment=LLM_PANEL_CONFIG=@@CONFIG_FILE@@
Environment=PYTHONUNBUFFERED=1
# Валидация конфига до поднятия сервера: неверный путь/порт — понятная ошибка в journal.
ExecStart=@@PANEL_DIR@@/.venv/bin/python -m llm_panel --config @@CONFIG_FILE@@ serve
Restart=on-failure
RestartSec=5

# --- Sandbox (аудит №9): опции, совместимые с sudo -n <helper> --------------
# Похожих по смыслу NoNewPrivileges / CapabilityBoundingSet / RestrictSUIDSGID
# НЕ добавлять — см. предупреждения выше (уроки станции).
#
# Раскомментируйте ПО ОДНОЙ и проверяйте после каждой: статусы сервисов,
# запись БД, браузер, sudo -n … journal <юнит>. Ошибка любой опции видна в
# journalctl -u llm-panel (systemd пишет, какая именно опция сработала).
#
#   * ProtectSystem=strict — вся ФС read-only; ПЕРЕД включением заполните
#     ReadWritePaths= под эту станцию (каталог данных, корни моделей для
#     HF-загрузок): иначе БД/аудит и `hf download` дадут Errno 30.
#   * PrivateTmp=yes — изолированные /tmp (helper и journalctl их не требуют).
#   * ProtectKernel* / ProtectControlGroups / RestrictNamespaces /
#     LockPersonality — read-/запрет-ядерным интерфейсам, с sudo не конфликтуют.
#
# --- Рабочий минимальный набор (соответствует серверу панели): ---------------
# ProtectSystem=strict
# ReadWritePaths=/var/lib/llm-panel /home/dispot/models /home/dispot/llm-panel
# PrivateTmp=yes
# ProtectKernelTunables=yes
# ProtectKernelModules=yes
# ProtectKernelLogs=yes
# ProtectControlGroups=yes
# RestrictNamespaces=yes
# LockPersonality=yes
#
[Install]
WantedBy=multi-user.target
